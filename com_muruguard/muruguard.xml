<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
    <name>com_muruguard</name>
    <author>ZKRANA</author>
    <creationDate>2026-10-04</creationDate>
    <copyright>Copyright (C) 2026 ZKRANA. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>zkranao@gmail.com</authorEmail>
    <authorUrl>https://store.lyzerslab.com/joomla-products/muru-guard-security-scanner</authorUrl>
    <version>4.0.0</version>
    <description>COM_MURUGUARD_XML_DESCRIPTION</description>

    <scriptfile>script.php</scriptfile>

    <media destination="com_muruguard" folder="media">
        <folder>css</folder>
        <file>index.html</file>
    </media>

    <administration>
        <menu img="class:shield">MuRu Guard</menu>

        <files folder="admin">
            <folder>controllers</folder>
            <folder>models</folder>
            <folder>views</folder>
            <folder>helpers</folder>
            <folder>language</folder>
            <file>access.xml</file>
            <file>config.xml</file>
            <file>controller.php</file>
            <file>muruguard.php</file>
            <file>index.html</file>
            <file>LICENSE.txt</file>
        </files>

        <languages folder="admin/language">
            <language tag="en-GB">en-GB/en-GB.com_muruguard.ini</language>
            <language tag="en-GB">en-GB/en-GB.com_muruguard.sys.ini</language>
        </languages>
    </administration>

    <updateservers>
        <server type="extension" priority="1" name="MuRu Guard Security Scanner">https://store.lyzerslab.com/api/joomla-update/free</server>
    </updateservers>
</extension>
